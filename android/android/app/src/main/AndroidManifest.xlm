<manifest xmlns:android="http://android.com"
    package="com.example.tago_portail"> <!-- Votre package ici -->
    
    <application
        android:label="TAGO PORTAIL"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|locale|layoutDirection|fontScale|screenHeight|uiMode">
            
            <!-- 1. AJOUTEZ/VÉRIFIEZ CETTE BALISE POUR L'EMBEDDING V2 -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- 2. SUPPRIMEZ IMPÉRATIVEMENT TOUTE BALISE NOMMÉE : -->
            <!-- io.flutter.app.android.SplashScreenUntilFirstFrame -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>

